# Sumber data — terlalu besar dan berisi citra lalu lintas yang dapat diidentifikasi
*.mp4
*.mkv
*.avi
*.mov

# Klip bukti riset: dipotong tanpa re-encode
!clips/
!clips/*.mp4

# Intermediate pemrosesan (dapat diregenerasi dari video)
frames/*.ppm
frames/tm*.png
frames/chk_*.png
frames/mask*.png
f2/*.pgm
f2/*.ppm
f2/tm_*.png
f2/g_*.pgm

# Dataset eksternal dan hasil validasi — tidak masuk git
data/
out/

# Sistem
Thumbs.db
desktop.ini
.DS_Store
node_modules/

# Python
__pycache__/
*.pyc
